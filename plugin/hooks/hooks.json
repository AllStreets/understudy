{
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "command -v understudy >/dev/null 2>&1 && understudy hook || true", "timeout": 600 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "command -v understudy >/dev/null 2>&1 && understudy archive >/dev/null 2>&1 || true", "timeout": 60 } ] }
    ]
  }
}
